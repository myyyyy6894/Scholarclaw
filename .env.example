# ============================================================================
# ScholarClaw 部署环境变量示例
#
# 用法：复制为 .env 并填入真实值（.env 已被 .gitignore 排除，绝不入库）。
#   cp .env.example .env
#
# 注入边界（docs/02 §13.2：按容器最小权限注入，严禁对任何容器全量挂载 env_file）：
#   - SC_MASTER_KEY / SC_JWT_SECRET          → 仅 sc-java-backend
#   - SC_DB_PASSWORD                         → sc-mysql、sc-java-backend（严禁给 Python）
#   - SC_DB_ROOT_PASSWORD                    → 仅 sc-mysql
#   - SC_REDIS_PASSWORD                      → sc-redis、sc-java-backend（严禁给 Python）
#   - SC_RABBITMQ_*                          → sc-rabbitmq、sc-java-backend、sc-python-ai
#   - SC_INTERNAL_SERVICE_TOKEN              → sc-java-backend、sc-python-ai
#   - SC_ONEBOT_ACCESS_TOKEN                 → sc-java-backend（接入 OneBot 时另加 NapCat 容器）
#
# 占位值一律是明显无效的示例，**不要**直接用于生产。
# ============================================================================

# ---------- 通用 ----------
# 用户时区与容器时区基准（ENV-01：必须显式固定，严禁依赖宿主机时区）
SC_TIMEZONE=Asia/Shanghai
# Web 对外入口的宿主机端口。生产默认 80；若 80 被占用可改为 8080。
SC_WEB_HTTP_PORT=80

# ---------- MySQL ----------
SC_DB_HOST=sc-mysql
SC_DB_PORT=3306
SC_DB_NAME=scholarclaw
SC_DB_USER=scholarclaw
SC_DB_PASSWORD=CHANGE_ME_db_user_password
SC_DB_ROOT_PASSWORD=CHANGE_ME_db_root_password

# ---------- Redis（仅 Java 访问，不做 MySQL 二级缓存）----------
SC_REDIS_HOST=sc-redis
SC_REDIS_PORT=6379
SC_REDIS_PASSWORD=CHANGE_ME_redis_password

# ---------- RabbitMQ（仅承载文档解析/重试/重建）----------
SC_RABBITMQ_HOST=sc-rabbitmq
SC_RABBITMQ_PORT=5672
SC_RABBITMQ_USER=scholarclaw
SC_RABBITMQ_PASSWORD=CHANGE_ME_rabbitmq_password

# ---------- 内部调用鉴权（Java ↔ Python）----------
# 两侧使用常量时间比较校验；**留空即失败关闭**（所有 /internal/** 请求一律 403）。
SC_INTERNAL_SERVICE_TOKEN=CHANGE_ME_internal_service_token
# sc-python-ai 内部基址：Java 的健康检查会真实调用它（TASK-105）。
# 仅注入 Java 容器；它的探针结果只出现在响应体的 data.peers，不参与 data.status 判定。
SC_PYTHON_AI_BASE_URL=http://sc-python-ai:8000
# sc-java-backend 内部基址：仅注入 Python 容器，供容器 healthcheck
# （sc-python-ai/healthcheck.py）验证 Python → Java 方向的双向调通（02 §15.1）；
# 应用代码在 TASK-503 引入 JavaInternalApiClient 时复用同一变量。
SC_JAVA_BACKEND_BASE_URL=http://sc-java-backend:8080
# 依赖探针超时（毫秒），仅用于 TCP 可达性探测
SC_DEPENDENCY_PROBE_TIMEOUT_MILLIS=1500
# 模型探测超时（Java → Python 内部调用，毫秒）。仅注入 Java 容器。
SC_MODEL_CONNECT_TIMEOUT_MILLIS=5000
SC_MODEL_READ_TIMEOUT_MILLIS=10000
# 模型出站超时（Python → 供应商，秒）。仅注入 Python 容器。
SC_MODEL_CONNECT_TIMEOUT_SECONDS=5
SC_MODEL_READ_TIMEOUT_SECONDS=30

# ---------- 派生索引（ChromaDB）----------
# 仅注入 Python 容器；其健康探针会调用 <基址>/api/v1/heartbeat（04 §4.9.8）。
# 留空则不注册该探针（单机只跑 Python 时不会误报 DOWN）；容器编排里默认值即下方默认。
SC_CHROMADB_BASE_URL=http://sc-chromadb:8000

# ---------- 数据库初始化与迁移（TASK-201）----------
# 启动期自动执行 db/migration/V*.sql（有序 + 版本表 sc_schema_migration），仅注入 Java 容器。
# 生产若由运维用特权账号先手工迁移，可设为 false（版本表会让迁移器判断"已是最新"）。
SC_DB_MIGRATION_ENABLED=true
# MySQL / Redis 健康探针是否走连接池（true=能证明凭据正确；false=退回 TCP 可达性）
SC_DB_POOL_PROBE=true
SC_REDIS_POOL_PROBE=true

# ---------- 仅 Java 独占 ----------
# AES-256-GCM 主密钥：必须是 32 字节的 Base64。生成方式：
#   openssl rand -base64 32
# ⚠️ 该密钥一旦用于加密用户 API Key 后**不可随意更换**，否则已存密文无法解密。
SC_MASTER_KEY=CHANGE_ME_32_bytes_base64
# JWT 签名密钥：≥32 字节高熵字符串。生成方式：openssl rand -base64 48
# ⚠️ 未注入或长度 <32 字节时 Java 直接拒绝启动（失败关闭，见 JwtService）
SC_JWT_SECRET=CHANGE_ME_jwt_secret_at_least_32_bytes
# 访问令牌有效期（秒），默认 604800（7 天，与 04 §2.7.2 一致）
SC_JWT_TTL_SECONDS=604800

# ---------- 模型出站白名单（Java 与 Python 共享）----------
# 默认 false：不允许访问本地/局域网的本地模型（Ollama）。显式开启后仍须命中下方白名单。
SC_ALLOW_LOCAL_MODEL_BASE_URL=false
# 手动重试/重建：TASK-501 已提供 MQ 生产者；消费者 TASK-502 接入前文档会停在 PARSING。
SC_MANUAL_INGEST_ENABLED=true
# 上传半成品恢复扫描（默认开启）。
SC_UPLOAD_RECOVERY_ENABLED=true
# 文档解析 MQ 生产者（TASK-501）；关闭时不会连接 RabbitMQ。
SC_MQ_INGEST_ENABLED=true
SC_MQ_INGEST_EXCHANGE=rag.ingest.exchange
SC_MQ_INGEST_QUEUE=rag.ingest.queue
SC_MQ_INGEST_DLQ=rag.ingest.dlq
# Python 文档解析消费者：TASK-503/504 回调与向量接入前保持 false。
SC_INGEST_CONSUMER_ENABLED=false
# 单 PDF 页数上限（TASK-502 解析阶段强制）。
SC_INGEST_MAX_PAGES=300
# 僵尸任务补投巡检（默认开启）。
SC_ZOMBIE_SCAN_ENABLED=true
# 逗号分隔的精确 Origin 白名单，例如 http://127.0.0.1:11434
SC_LOCAL_MODEL_ALLOWED_ORIGINS=

# ---------- IM 主动推送 ----------
# 总开关（一键熔断降级为站内信）；MVP 默认关闭
SC_IM_PUSH_ENABLED=false
SC_ONEBOT_ACCESS_TOKEN=CHANGE_ME_onebot_access_token

# ---------- 应用日志级别（Python 侧读取）----------
SC_LOG_LEVEL=INFO
