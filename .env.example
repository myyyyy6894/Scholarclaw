# ============================================================================
# ScholarClaw 部署环境变量示例
#
# 用法：复制为 .env 并填入真实值（.env 已被 .gitignore 排除，绝不入库）。
#   cp .env.example .env
#
# 注入边界（docs/02 §13.2：按容器最小权限注入，严禁对任何容器全量挂载 env_file）：
#   - SC_MASTER_KEY / SC_JWT_SECRET          → 仅 sc-java-backend
#   - SC_DB_PASSWORD                         → sc-mysql、sc-java-backend（严禁给 Python）
#   - SC_DB_ROOT_PASSWORD                    → 仅 sc-mysql
#   - SC_REDIS_PASSWORD                      → sc-redis、sc-java-backend（严禁给 Python）
#   - SC_RABBITMQ_*                          → sc-rabbitmq、sc-java-backend、sc-python-ai
#   - SC_INTERNAL_SERVICE_TOKEN              → sc-java-backend、sc-python-ai
#   - SC_ONEBOT_ACCESS_TOKEN                 → sc-java-backend（接入 OneBot 时另加 NapCat 容器）
#
# 占位值一律是明显无效的示例，**不要**直接用于生产。
# ============================================================================

# ---------- 通用 ----------
# 用户时区与容器时区基准（ENV-01：必须显式固定，严禁依赖宿主机时区）
SC_TIMEZONE=Asia/Shanghai
# Web 对外入口的宿主机端口。生产默认 80；若 80 被占用可改为 8080。
SC_WEB_HTTP_PORT=80

# ---------- MySQL ----------
SC_DB_HOST=sc-mysql
SC_DB_PORT=3306
SC_DB_NAME=scholarclaw
SC_DB_USER=scholarclaw
SC_DB_PASSWORD=CHANGE_ME_db_user_password
SC_DB_ROOT_PASSWORD=CHANGE_ME_db_root_password

# ---------- Redis（仅 Java 访问，不做 MySQL 二级缓存）----------
SC_REDIS_HOST=sc-redis
SC_REDIS_PORT=6379
SC_REDIS_PASSWORD=CHANGE_ME_redis_password

# ---------- RabbitMQ（仅承载文档解析/重试/重建）----------
SC_RABBITMQ_HOST=sc-rabbitmq
SC_RABBITMQ_PORT=5672
SC_RABBITMQ_USER=scholarclaw
SC_RABBITMQ_PASSWORD=CHANGE_ME_rabbitmq_password

# ---------- 内部调用鉴权（Java ↔ Python）----------
# 两侧使用常量时间比较校验；**留空即失败关闭**（所有 /internal/** 请求一律 403）。
SC_INTERNAL_SERVICE_TOKEN=CHANGE_ME_internal_service_token

# ---------- 仅 Java 独占 ----------
# AES-256-GCM 主密钥：必须是 32 字节的 Base64。生成方式：
#   openssl rand -base64 32
# ⚠️ 该密钥一旦用于加密用户 API Key 后**不可随意更换**，否则已存密文无法解密。
SC_MASTER_KEY=CHANGE_ME_32_bytes_base64
# JWT 签名密钥：≥32 字节高熵字符串。生成方式：openssl rand -base64 48
SC_JWT_SECRET=CHANGE_ME_jwt_secret_at_least_32_bytes

# ---------- 模型出站白名单（Java 与 Python 共享）----------
# 默认 false：不允许访问本地/局域网的本地模型（Ollama）。显式开启后仍须命中下方白名单。
SC_ALLOW_LOCAL_MODEL_BASE_URL=false
# 逗号分隔的精确 Origin 白名单，例如 http://127.0.0.1:11434
SC_LOCAL_MODEL_ALLOWED_ORIGINS=

# ---------- IM 主动推送 ----------
# 总开关（一键熔断降级为站内信）；MVP 默认关闭
SC_IM_PUSH_ENABLED=false
SC_ONEBOT_ACCESS_TOKEN=CHANGE_ME_onebot_access_token

# ---------- 应用日志级别（Python 侧读取）----------
SC_LOG_LEVEL=INFO
