# ============================================================================
# ScholarClaw 部署环境变量示例
#
# 用法：复制为 .env 并填入真实值（.env 已被 .gitignore 排除，绝不入库）。
#   cp .env.example .env
#
# 注入边界（docs/02 §13.2：按容器最小权限注入，严禁对任何容器全量挂载 env_file）：
#   - SC_MASTER_KEY / SC_JWT_SECRET          → 仅 sc-java-backend
#   - SC_DB_PASSWORD                         → sc-mysql、sc-java-backend（严禁给 Python）
#   - SC_DB_ROOT_PASSWORD                    → 仅 sc-mysql
#   - SC_REDIS_PASSWORD                      → sc-redis、sc-java-backend（严禁给 Python）
#   - SC_RABBITMQ_*                          → sc-rabbitmq、sc-java-backend、sc-python-ai
#   - SC_INTERNAL_SERVICE_TOKEN              → sc-java-backend、sc-python-ai
#
# 占位值一律是明显无效的示例，**不要**直接用于生产。
# ============================================================================

# ---------- 通用 ----------
# 用户时区与容器时区基准（ENV-01：必须显式固定，严禁依赖宿主机时区）
SC_TIMEZONE=Asia/Shanghai
# Web 对外入口的宿主机端口。生产默认 80；若 80 被占用可改为 8080。
SC_WEB_HTTP_PORT=80
# 宿主机绑定地址。默认 0.0.0.0 = 直接对外（仅在没有前置 HTTPS 时使用）。
# 用宿主机 Nginx / 云负载均衡做 HTTPS 终止时改成 127.0.0.1，
# 保证公网只能走 443，不能绕过证书直连 http://IP:端口。
SC_WEB_HTTP_BIND=0.0.0.0
# 部署方联系 QQ（非密钥，可选）。填写后，使用指南页会显示「使用问题可加 QQ：xxxx」
# 并提供复制按钮；留空则整块隐藏。只接受数字。
SC_OPERATOR_QQ=
# 项目主页地址（非密钥，可选），显示在使用指南的「联系与反馈」里。
# 只接受 http(s) 绝对地址，其它值一律忽略。例：https://gitee.com/yourname/scholarclaw
SC_PROJECT_URL=
# ---------- MySQL ----------
SC_DB_HOST=sc-mysql
SC_DB_PORT=3306
SC_DB_NAME=scholarclaw
SC_DB_USER=scholarclaw
SC_DB_PASSWORD=CHANGE_ME_db_user_password
SC_DB_ROOT_PASSWORD=CHANGE_ME_db_root_password

# ---------- Redis（仅 Java 访问，不做 MySQL 二级缓存）----------
SC_REDIS_HOST=sc-redis
SC_REDIS_PORT=6379
SC_REDIS_PASSWORD=CHANGE_ME_redis_password

# ---------- RabbitMQ（仅承载文档解析/重试/重建）----------
SC_RABBITMQ_HOST=sc-rabbitmq
SC_RABBITMQ_PORT=5672
SC_RABBITMQ_USER=scholarclaw
SC_RABBITMQ_PASSWORD=CHANGE_ME_rabbitmq_password

# ---------- 内部调用鉴权（Java ↔ Python）----------
# 两侧使用常量时间比较校验；**留空即失败关闭**（所有 /internal/** 请求一律 403）。
SC_INTERNAL_SERVICE_TOKEN=CHANGE_ME_internal_service_token
# sc-python-ai 内部基址：Java 的健康检查会真实调用它（TASK-105）。
# 仅注入 Java 容器；它的探针结果只出现在响应体的 data.peers，不参与 data.status 判定。
SC_PYTHON_AI_BASE_URL=http://sc-python-ai:8000
# sc-java-backend 内部基址：仅注入 Python 容器，供容器 healthcheck
# （sc-python-ai/healthcheck.py）验证 Python → Java 方向的双向调通（02 §15.1）；
# 应用代码在 TASK-503 引入 JavaInternalApiClient 时复用同一变量。
SC_JAVA_BACKEND_BASE_URL=http://sc-java-backend:8080
# 依赖探针超时（毫秒），仅用于 TCP 可达性探测
SC_DEPENDENCY_PROBE_TIMEOUT_MILLIS=1500
# 模型探测超时（Java → Python 内部调用，毫秒）。仅注入 Java 容器。
SC_MODEL_CONNECT_TIMEOUT_MILLIS=5000
SC_MODEL_READ_TIMEOUT_MILLIS=10000
# 模型出站超时（Python → 供应商，秒）。仅注入 Python 容器。
SC_MODEL_CONNECT_TIMEOUT_SECONDS=5
SC_MODEL_READ_TIMEOUT_SECONDS=30

# ---------- 平台默认向量模型（可选，仅注入 Java 容器）----------
# 部署方自己跑 Embedding 服务、使用者只提供对话模型 Key 时启用。
# 五项（Provider/BaseURL/模型名/维度/Key）必须齐全，否则 Java 启动失败（避免"以为开了"）。
# 启用后，新注册账号自动带上这套 Embedding；已有账号在下次登录时补齐（只补没有有效配置的）。
# 用户仍可在设置页覆盖；界面会标注「平台默认」。五项缺一项 Java 启动失败。
# Provider 只支持 OPENAI_COMPATIBLE / ZHIPU / OLLAMA（DeepSeek 不提供向量模型）。
# 若地址是内网/本地（如 http://127.0.0.1:11434），必须同时设置：
#   SC_ALLOW_LOCAL_MODEL_BASE_URL=true
#   SC_LOCAL_MODEL_ALLOWED_ORIGINS=<origin>（如 http://127.0.0.1:11434）
# 否则建课时的 Base URL 安全校验会拒绝该地址。
SC_PLATFORM_EMBEDDING_PROVIDER=
SC_PLATFORM_EMBEDDING_BASE_URL=
SC_PLATFORM_EMBEDDING_MODEL=
SC_PLATFORM_EMBEDDING_DIM=0
SC_PLATFORM_EMBEDDING_API_KEY=
# 用仓库自带的 Ollama（profile=embedding）当平台向量模型时，填这一组：
#   SC_PLATFORM_EMBEDDING_PROVIDER=OLLAMA
#   SC_PLATFORM_EMBEDDING_BASE_URL=http://sc-ollama:11434/v1
#   SC_PLATFORM_EMBEDDING_MODEL=qwen3-embedding:0.6b
#   SC_PLATFORM_EMBEDDING_DIM=1024
#   SC_PLATFORM_EMBEDDING_API_KEY=（留空，本地 Ollama 免密）
#   SC_ALLOW_LOCAL_MODEL_BASE_URL=true
#   SC_LOCAL_MODEL_ALLOWED_ORIGINS=http://sc-ollama:11434
# 可选 Ollama 容器参数（仅 profile=embedding 生效）：
#   SC_OLLAMA_KEEP_ALIVE=30m        模型常驻时长；内存充足建议 -1（永不卸载，避免冷启动重载）
#   SC_OLLAMA_MEM_LIMIT=2048m       容器内存上限；跑 bge-m3 时建议 3072m
# 冷启动首次加载模型较慢时，把 Python 的出站超时放宽（改完重启 sc-python-ai）：
#   SC_MODEL_READ_TIMEOUT_SECONDS=120

# ---------- 派生索引（ChromaDB）----------
# 仅注入 Python 容器；其健康探针会调用 <基址>/api/v1/heartbeat（04 §4.9.8）。
# 留空则不注册该探针（单机只跑 Python 时不会误报 DOWN）；容器编排里默认值即下方默认。
SC_CHROMADB_BASE_URL=http://sc-chromadb:8000

# ---------- 数据库初始化与迁移（TASK-201）----------
# 启动期自动执行 db/migration/V*.sql（有序 + 版本表 sc_schema_migration），仅注入 Java 容器。
# 生产若由运维用特权账号先手工迁移，可设为 false（版本表会让迁移器判断"已是最新"）。
SC_DB_MIGRATION_ENABLED=true
# MySQL / Redis 健康探针是否走连接池（true=能证明凭据正确；false=退回 TCP 可达性）
SC_DB_POOL_PROBE=true
SC_REDIS_POOL_PROBE=true

# ---------- 仅 Java 独占 ----------
# AES-256-GCM 主密钥：必须是 32 字节的 Base64。生成方式：
#   openssl rand -base64 32
# ⚠️ 该密钥一旦用于加密用户 API Key 后**不可随意更换**，否则已存密文无法解密。
SC_MASTER_KEY=CHANGE_ME_32_bytes_base64
# JWT 签名密钥：≥32 字节高熵字符串。生成方式：openssl rand -base64 48
# ⚠️ 未注入或长度 <32 字节时 Java 直接拒绝启动（失败关闭，见 JwtService）
SC_JWT_SECRET=CHANGE_ME_jwt_secret_at_least_32_bytes
# 访问令牌有效期（秒），默认 604800（7 天，与 04 §2.7.2 一致）
SC_JWT_TTL_SECONDS=604800

# ---------- 模型出站白名单（Java 与 Python 共享）----------
# 默认 false：不允许访问本地/局域网的本地模型（Ollama）。显式开启后仍须命中下方白名单。
SC_ALLOW_LOCAL_MODEL_BASE_URL=false
# 手动重试/重建：TASK-506 起消费者默认开启，入口按文档状态开放；可临时关闭生产端。
SC_MANUAL_INGEST_ENABLED=true
# 上传半成品恢复扫描（默认开启）。
SC_UPLOAD_RECOVERY_ENABLED=true
# 文档解析 MQ 生产者（TASK-501）；关闭时不会连接 RabbitMQ。
SC_MQ_INGEST_ENABLED=true
SC_MQ_INGEST_EXCHANGE=rag.ingest.exchange
SC_MQ_INGEST_QUEUE=rag.ingest.queue
SC_MQ_INGEST_DLQ=rag.ingest.dlq
SC_MQ_INGEST_PARKING=rag.ingest.parking
# parking 限速自动重放；超过上限转人工队列，需人工处理并告警
SC_MQ_INGEST_PARKING_MANUAL=rag.ingest.parking.manual
SC_MQ_INGEST_PARKING_REPLAY_ENABLED=true
SC_MQ_INGEST_PARKING_REPLAY_INTERVAL_MS=60000
SC_MQ_INGEST_PARKING_REPLAY_MAX_ATTEMPTS=3
SC_MQ_INGEST_VECTOR_COMPENSATION=rag.ingest.vector-compensation
SC_MQ_INGEST_CONFIRM_TIMEOUT_MS=5000
SC_ZOMBIE_SCAN_STALE_MINUTES=15
SC_ZOMBIE_SCAN_INTERVAL_MS=300000
# Python 文档解析消费者：TASK-506 联调通过后默认开启；关闭时文档会停在 PARSING。
SC_INGEST_CONSUMER_ENABLED=true
# 单 PDF 页数上限（TASK-502 解析阶段强制）。
SC_INGEST_MAX_PAGES=300
# 僵尸任务补投巡检（默认开启）。
SC_ZOMBIE_SCAN_ENABLED=true
# DDL 定时提醒（TASK-801）：T-24h / T-6h / 逾期 / 待确认跟进；默认每分钟扫描。
SC_DDL_REMINDER_ENABLED=true
SC_DDL_REMINDER_INITIAL_DELAY_MS=60000
SC_DDL_REMINDER_INTERVAL_MS=60000
SC_DDL_REMINDER_BATCH_SIZE=200
SC_DDL_REMINDER_LOCK_TTL_SECONDS=50
# 删除残留与孤儿资源 GC（TASK-902）：每 60 分钟扫描 DEACTIVATING 用户、
# DELETING 文档、is_deleting 课程与 raw 孤儿文件；失败幂等重试。
SC_DELETION_GC_ENABLED=true
SC_DELETION_GC_INITIAL_DELAY_MS=60000
SC_DELETION_GC_INTERVAL_MS=3600000
SC_DELETION_GC_STALE_MINUTES=10
SC_DELETION_GC_ORPHAN_FILE_MINUTES=60
SC_DELETION_GC_BATCH_SIZE=200
SC_DELETION_GC_LOCK_TTL_SECONDS=300
# 向量清理 outbox 租约（秒）与 ChromaDB 孤儿 Collection 对账
SC_DELETION_GC_OUTBOX_LEASE_SECONDS=120
SC_DELETION_GC_CHROMA_RECONCILE_ENABLED=true
SC_DELETION_GC_CHROMA_READ_TIMEOUT_SECONDS=30
# 逗号分隔的精确 Origin 白名单，例如 http://127.0.0.1:11434
SC_LOCAL_MODEL_ALLOWED_ORIGINS=
# AUTO_ROUTE / DDL 提取调用 Python 的读取超时（秒）；真实供应商 1600 max_tokens 下可超过 15s。
SC_AGENT_ROUTE_READ_TIMEOUT_SECONDS=60
SC_DDL_EXTRACT_READ_TIMEOUT_SECONDS=60

# ---------- IM 主动推送 ----------
# 总开关（一键熔断降级为站内信）；MVP 默认关闭
SC_IM_PUSH_ENABLED=false
# TASK-804：IM 出站调度、官方 QQ 投递（SC_IM_PUSH_ENABLED=false 时自动仅站内信）。
SC_NOTIFICATION_OUTBOUND_ENABLED=true
SC_NOTIFICATION_OUTBOUND_INITIAL_DELAY_MS=30000
SC_NOTIFICATION_OUTBOUND_INTERVAL_MS=10000
SC_NOTIFICATION_OUTBOUND_BATCH_SIZE=5
SC_NOTIFICATION_OUTBOUND_LEASE_SECONDS=60
SC_NOTIFICATION_OUTBOUND_RETRY_DELAY_SECONDS=30
# ---------- 应用日志级别（Python 侧读取）----------
SC_LOG_LEVEL=INFO

# ---------- 构建期镜像源（可选；容器内不继承宿主机代理）----------
SC_PIP_INDEX_URL=https://pypi.org/simple
SC_NPM_REGISTRY=https://registry.npmjs.org
