# ============================================================================
# sc-python-ai 测试镜像（Python 3.11 + 运行时依赖 + 测试依赖）
#
# 为什么单独一个 Dockerfile：
#   * 生产镜像不带 pytest，符合“测试依赖不得污染生产运行时依赖”；
#   * 之前用临时目录挂载 pytest 的方式无法复现，本镜像把测试依赖装进镜像层。
#
# 构建与运行：
#   docker build -t scholarclaw/sc-python-ai-test:1.0.0 \
#     -f sc-python-ai/Dockerfile.test sc-python-ai
#   docker run --rm scholarclaw/sc-python-ai-test:1.0.0
#
# 或直接使用脚本：scripts/test_python.sh container
# ============================================================================
FROM scholarclaw/sc-python-ai:1.0.0

ARG PIP_INDEX_URL=https://pypi.org/simple

USER root
COPY requirements-dev.lock.txt /tmp/requirements-dev.lock.txt
RUN pip install --index-url "${PIP_INDEX_URL}" -r /tmp/requirements-dev.lock.txt

COPY --chown=10001:10001 tests /app/tests
WORKDIR /app
USER 10001:10001

CMD ["python", "-m", "pytest", "-q", "-p", "no:cacheprovider"]
